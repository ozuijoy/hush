# ── 必填 ──────────────────────────────────────────────
# Neon 連線字串（Dashboard → Connect，選 HTTP driver 的那個）
DATABASE_URL=postgres://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/hush?sslmode=require

# 唯一的管理員帳號：第一次登入時會自動建立
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# 也可以改放雜湊值（與明文二擇一）：
# ADMIN_PASSWORD_HASH=pbkdf2-sha256$100000$...（可用 scripts/hash-password 產生）

# ── 物件儲存（建議，正式環境）─────────────────────────
# 任何 S3 相容服務皆可：Backblaze B2 / Supabase Storage / MinIO / Wasabi。
# 刻意不使用 Cloudflare R2。
STORAGE_DRIVER=s3
S3_BUCKET=hush-files
S3_REGION=us-west-004
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
# 自架 MinIO / Supabase 需要 path-style：
# S3_FORCE_PATH_STYLE=true
# S3_PREFIX=hush/
# MAX_UPLOAD_MB=100

# 沒有 S3 設定時自動退回 Postgres 直存（單檔上限 4 MB，僅建議測試用）：
# STORAGE_DRIVER=pg

# ── AI（選用）：任何 OpenAI 相容端點；端點、金鑰、模型三個都設才啟用 ──
# AI_BASE_URL=https://api.example.com/v1
# AI_API_KEY=...
# AI_MODEL=your-model-name
# AI_TIMEOUT_SECONDS=     # 不設就不主動逾時
# AI_MAX_TOKENS=1024
# AI_HOURLY_LIMIT=30
# AI_STREAM=false        # 預設串流

# ── 其他 ──────────────────────────────────────────────
# AUTO_MIGRATE=false   # 關閉首次請求自動遷移（預設開啟）
# SESSION_DAYS=30
# APP_NAME=Hush