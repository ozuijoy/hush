{
  "name": "hush",
  "version": "1.0.0",
  "private": true,
  "description": "Hush — 私密羣組聊天與內部檔案分享（Cloudflare Pages / Netlify + Neon）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/run-ts.mjs scripts/dev-server.ts",
    "build": "vite build",
    "build:pages": "BUILD_TARGET=pages vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node scripts/run-ts.mjs scripts/migrate.ts",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "hono": "^4.9.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
